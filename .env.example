# InstantLink configuration (all optional)
# Where share records and the admin key are stored
IL_DATA_DIR=~/.instantlink
# Public (recipient) server. Default host is 127.0.0.1 = this computer only.
# Set to 0.0.0.0 to allow other devices on your Wi-Fi/LAN.
IL_PUBLIC_HOST=127.0.0.1
IL_PUBLIC_PORT=8080
# Admin API is ALWAYS bound to 127.0.0.1
IL_ADMIN_PORT=8081
# The URL recipients will use. Leave empty for local-only testing.
# Must be https:// in production (comes from your tunnel/gateway).
IL_PUBLIC_BASE_URL=
